import enum

class Side(enum.Enum):
    BID = 1
    ASK = 2

class L2Book:
    def __init__(self) -> None: ...
    def apply(self, side: Side, price: int, size: int) -> None: ...
    def apply_many(self, updates: list[tuple[int, int, int]]) -> None: ...
    def clear(self) -> None: ...
    def best(self, side: Side) -> tuple[int, int] | None: ...
    def top(self, side: Side, n: int) -> list[tuple[int, int]]: ...
    def crossed(self) -> bool: ...
    def truncate(self, depth: int) -> None: ...
    def depth(self, side: Side) -> int: ...
    def __len__(self) -> int: ...

class OrderType(enum.Enum):
    LIMIT = 1
    MARKET = 2
    IOC = 3

class EventType(enum.Enum):
    ACCEPTED = 1
    TRADE = 2
    CANCELLED = 3
    REJECTED = 4

class RejectReason(enum.Enum):
    NONE = 0
    DUPLICATE_ID = 1
    INVALID_SIZE = 2
    INVALID_PRICE = 3
    UNKNOWN_ORDER = 4

class Event:
    @property
    def seq(self) -> int: ...
    @property
    def type(self) -> EventType: ...
    @property
    def order(self) -> int: ...
    @property
    def maker(self) -> int: ...
    @property
    def side(self) -> Side: ...
    @property
    def price(self) -> int: ...
    @property
    def size(self) -> int: ...
    @property
    def reason(self) -> RejectReason: ...

class MatchingEngine:
    def __init__(self) -> None: ...
    def submit(
        self, order: int, side: Side, type: OrderType, price: int, size: int
    ) -> list[Event]: ...
    def cancel(self, order: int) -> list[Event]: ...
    def depth(self, side: Side, n: int) -> list[tuple[int, int]]: ...
    def best(self, side: Side) -> tuple[int, int] | None: ...
    def resting_orders(self) -> int: ...
    def last_seq(self) -> int: ...

def version() -> str: ...
def kraken_checksum(book: L2Book) -> int: ...
